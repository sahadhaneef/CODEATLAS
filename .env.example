# Development only. Generate two different random secrets before starting.
CODEATLAS_ENV=development
CODEATLAS_AUTH_MODE=development
# Generate with Python 3.12: from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())
# Back up this key outside the database; losing it makes retained source unreadable.
CODEATLAS_SOURCE_KEY=
CODEATLAS_BROKER_URL=redis://127.0.0.1:56379/0
CODEATLAS_DEV_TOKEN_A=replace-with-at-least-24-random-characters-a
CODEATLAS_DEV_TOKEN_B=replace-with-at-least-24-random-characters-b
CODEATLAS_DATABASE_URL=postgresql+psycopg://codeatlas:local-development-only@localhost:5432/codeatlas

