{
  "components": {
    "schemas": {
      "GrantRequest": {
        "properties": {
          "capability": {
            "pattern": "^(read|index)$",
            "title": "Capability",
            "type": "string"
          },
          "principal_id": {
            "maxLength": 36,
            "minLength": 1,
            "title": "Principal Id",
            "type": "string"
          }
        },
        "required": [
          "principal_id",
          "capability"
        ],
        "title": "GrantRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "IndexRequest": {
        "additionalProperties": false,
        "properties": {
          "ref": {
            "default": "main",
            "maxLength": 200,
            "title": "Ref",
            "type": "string"
          }
        },
        "title": "IndexRequest",
        "type": "object"
      },
      "Registration": {
        "additionalProperties": false,
        "properties": {
          "remote_url": {
            "maxLength": 512,
            "title": "Remote Url",
            "type": "string"
          },
          "requested_ref": {
            "default": "main",
            "maxLength": 200,
            "title": "Requested Ref",
            "type": "string"
          },
          "visibility_policy": {
            "default": "private",
            "pattern": "^private$",
            "title": "Visibility Policy",
            "type": "string"
          }
        },
        "required": [
          "remote_url"
        ],
        "title": "Registration",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
